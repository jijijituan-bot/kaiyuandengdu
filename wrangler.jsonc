{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaiyuandengdu",
  "compatibility_date": "2026-05-19",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "dist/static",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}